# --------------------------------------------
# Exemplo de variáveis de ambiente
# Copiar tudo abaixo e colocar em um novo .env
# --------------------------------------------

DB_HOST=db
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=customer_db
DB_PORT=5432

PORT=4003

# Precisa ser EXATAMENTE o mesmo valor usado no .env do auth-service,
# já que é o auth quem emite o token que essas rotas validam.
JWT_SECRET=change-me
