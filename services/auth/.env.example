# --------------------------------------------
# Exemplo de variáveis de ambiente
# Copiar tudo abaixo e colocar em um novo .env
# --------------------------------------------

DB_HOST=db
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db
DB_PORT=5432

CUSTOMER_API_URL=http://customer:4003

# Precisa ser EXATAMENTE o mesmo valor usado no .env do customer-service,
# já que é ele quem valida os tokens emitidos aqui.
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

PORT=4005
